{
  "name": "himekuri-ios",
  "version": "1.0.0",
  "private": true,
  "description": "じぶん日めくり 自分で作る日めくりカレンダー iOSアプリ (Capacitorラッパー + WidgetKit)",
  "scripts": {
    "sync-web": "bash sync-web.sh",
    "sync": "npm run sync-web && npx cap sync ios",
    "open": "npx cap open ios",
    "icons": "npx @capacitor/assets generate --ios --iconBackgroundColor '#c8452c' --iconBackgroundColorDark '#c8452c' --splashBackgroundColor '#ebe6dc' --splashBackgroundColorDark '#17161a'"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/preferences": "^7.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9"
  }
}
